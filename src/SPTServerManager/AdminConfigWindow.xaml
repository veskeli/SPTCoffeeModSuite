<Window x:Class="SPTServerManager.AdminConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SPTServerManager"
        mc:Ignorable="d"
        Title="AdminConfigWindow" Height="300" Width="700"
        ResizeMode="NoResize"
        Background="#1e1e1e" Foreground="White"
        WindowStyle="None">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <local:WindowHeader Grid.Row="0" HeaderText="Admin config" />

        <!-- Main Content -->
        <StackPanel Grid.Row="1">
            <!-- Note -->
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Note:" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                <TextBox Grid.Column="1" x:Name="NoteTextBlock" Height="30" Margin="0,10,0,5" Background="#2b2b2b" BorderBrush="#3a3a3a" Foreground="White"/>
            </Grid>

            <!-- Secret -->
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Secret:" FontWeight="Bold" Foreground="White" Margin="0,10,0,5"/>
                <Button Grid.Column="1" Content="Show" Width="50" Height="30" Margin="0,10,5,5"
                        Click="ToggleSecretVisibilityButton_Click"
                        Background="DarkCyan" Foreground="White" BorderBrush="#3c3c3c"/>
                <TextBox Grid.Column="2" x:Name="SecretTextBox" Height="30" Margin="0,10,0,5" Background="#2b2b2b" BorderBrush="#3a3a3a" Foreground="White"/>
                <Button Grid.Column="3" Content="Generate" Width="100" Height="30" Margin="10,10,0,5"
                        Click="GenerateSecretButton_Click"
                        Background="DarkCyan" Foreground="White" BorderBrush="#3c3c3c"/>
            </Grid>

            <!-- IsEnabled -->
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Is Enabled:" FontWeight="Bold" Foreground="White" Margin="0,10,0,5"/>
                <CheckBox Grid.Column="1" x:Name="IsEnabledCheckBox" VerticalAlignment="Center" Margin="0,10,0,5"/>
            </Grid>

            <!-- Allow Headless Close -->
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Allow Headless Close:" FontWeight="Bold" Foreground="White" Margin="0,10,0,5"/>
                <CheckBox Grid.Column="1" x:Name="AllowHeadlessCloseCheckBox" VerticalAlignment="Center" Margin="0,10,0,5"/>
            </Grid>

        </StackPanel>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,10">
            <Button Content="Save" Width="80" Height="30" Margin="0,0,10,0"
                    Click="SaveButton_Click"
                    Background="DarkOliveGreen" Foreground="White" BorderBrush="#3c3c3c"/>
            <Button Content="Cancel" Width="80" Height="30"
                    Click="CancelButton_Click"
                    Background="DarkRed" Foreground="White" BorderBrush="#3c3c3c"/>
        </StackPanel>
    </Grid>
</Window>
