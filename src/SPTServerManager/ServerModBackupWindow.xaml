<Window x:Class="SPTServerManager.ServerModBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sptServerManager="clr-namespace:SPTServerManager"
        Title="Server Mod Backups" Height="560" Width="860"
        ResizeMode="NoResize"
        Background="#1e1e1e" Foreground="White"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <sptServerManager:WindowHeader Grid.Row="0" HeaderText="Archived Server Mod Backups" />

        <StackPanel Grid.Row="1" Margin="16,16,16,8">
            <TextBlock Text="Select a backup to restore to local, or remove old backups." Foreground="LightGray" Margin="0,0,0,8"/>
            <ListView x:Name="BackupsListView" Height="410" Background="#2d2d30" Foreground="White" BorderBrush="#555" SelectionMode="Extended">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Mod" Width="170" DisplayMemberBinding="{Binding ModName}" />
                        <GridViewColumn Header="Version" Width="100" DisplayMemberBinding="{Binding Version}" />
                        <GridViewColumn Header="File" Width="260" DisplayMemberBinding="{Binding FileName}" />
                        <GridViewColumn Header="Archived (UTC)" Width="190" DisplayMemberBinding="{Binding ArchivedUtc}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,8,16,16">
            <Button Content="Restore Selected (Queue Pending)" Width="230" Margin="0,0,8,0"
                    Background="DarkSlateBlue" Foreground="White"
                    Click="RestoreSelected_Click"/>
            <Button Content="Move Selected Backup(s) to Temp" Width="220" Margin="0,0,8,0"
                    Background="#6b2f2f" Foreground="White"
                    Click="RemoveSelected_Click"/>
            <Button Content="Close" Width="90"
                    Background="DarkRed" Foreground="White"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>

