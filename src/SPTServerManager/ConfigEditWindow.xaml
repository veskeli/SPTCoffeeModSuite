<Window x:Class="SPTServerManager.ConfigEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sptServerManager="clr-namespace:SPTServerManager"
        Title="Edit Config" Height="300" Width="420"
        ResizeMode="NoResize"
        Background="#1e1e1e" Foreground="White"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <sptServerManager:WindowHeader Grid.Row="0" HeaderText="Config Settings" />

        <StackPanel Grid.Row="1" Margin="16">
            <Label Content="File Name (e.g. my.config.cfg):" Foreground="White"/>
            <TextBox x:Name="FileNameBox" Background="#2d2d30" Foreground="White" BorderBrush="#555"
                     Margin="0,0,0,8" Padding="4"/>

            <Label Content="Last Modified (UTC):" Foreground="White"/>
            <DatePicker x:Name="LastModifiedDatePicker" Margin="0,0,0,8"/>

            <CheckBox x:Name="IsEnforcedCheck" Content="Is Enforced" Foreground="White" Margin="0,4"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Save" Width="80" Margin="0,0,8,0"
                        Background="DarkOliveGreen" Foreground="White"
                        Click="Save_Click"/>
                <Button Content="Cancel" Width="80"
                        Background="DarkRed" Foreground="White"
                        Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>

