<Window x:Class="SPTServerManager.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SPTServerManager"
        mc:Ignorable="d"
        Title="SettingsWindow" Height="300" Width="500"
        ResizeMode="NoResize"
        Background="#1e1e1e" Foreground="White"
        WindowStyle="None">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <local:WindowHeader Grid.Row="0" HeaderText="Settings" />

        <Grid Grid.Row="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Mods Path -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="Mods Path:" VerticalAlignment="Center" Foreground="White" Margin="0,0,5,0"/>
                <TextBox Grid.Column="1" x:Name="ModsPathTextBox" Margin="0,0,5,0"/>
                <Button Grid.Column="2" Content="Browse" Click="BrowseModsPath_Click" Width="55" Background="DodgerBlue" Margin="0,0,5,0"/>
                <Button Grid.Column="3" Content="Open" Click="OpenModsPath_Click" Width="50" Background="DodgerBlue"/>
            </Grid>

            <!-- Server Address and Port -->
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="Port:" VerticalAlignment="Center" Foreground="White" Margin="0,0,5,0"/>
                <TextBox Grid.Column="1" x:Name="LauncherPortTextBox" Margin="0,0,115,0"/>
            </Grid>

            <!-- SPT Server Folder Path -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="SPT Server Folder:" VerticalAlignment="Center" Foreground="White" Margin="0,0,5,0"/>
                <TextBox Grid.Column="1" x:Name="ServerFolderPathTextBox" Margin="0,0,5,0"/>
                <Button Grid.Column="2" Content="Browse" Click="BrowseServerFolderPath_Click" Width="55" Background="DodgerBlue" Margin="0,0,5,0"/>
                <Button Grid.Column="3" Content="Open" Click="OpenServerFolderPath_Click" Width="50" Background="DodgerBlue"/>
            </Grid>

            <!-- Additional mods folder path -->
            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="Additional Mods Folder:" VerticalAlignment="Center" Foreground="White" Margin="0,0,5,0"/>
                <TextBox Grid.Column="1" x:Name="AdditionalModsPathTextBox" Margin="0,0,5,0"/>
                <Button Grid.Column="2" Content="Browse" Click="BrowseAdditionalModsPath_Click" Width="55" Background="DodgerBlue" Margin="0,0,5,0"/>
                <Button Grid.Column="3" Content="Open" Click="OpenAdditionalModsPath_Click" Width="50" Background="DodgerBlue"/>
            </Grid>
        </Grid>

        <!-- Save and cancel Buttons -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Center" Margin="0,5,0,0">
            <Button Content="Save" Width="100" Margin="5" Click="SaveSettings_Click" Background="ForestGreen" Height="24"/>
            <Button Content="Cancel" Width="100" Margin="5" Click="CancelSettings_Click" Background="DarkRed"/>
        </StackPanel>

    </Grid>
</Window>
