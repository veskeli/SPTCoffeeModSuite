<Window x:Class="SPTServerManager.IncomingFilePreviewLoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sptServerManager="clr-namespace:SPTServerManager"
        Title="Preparing Preview" Height="220" Width="620"
        ResizeMode="NoResize"
        Background="#1e1e1e" Foreground="White"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <sptServerManager:WindowHeader Grid.Row="0" HeaderText="Preparing Incoming File Preview" />

        <StackPanel Grid.Row="1" Margin="18" VerticalAlignment="Center">
            <TextBlock Text="Scanning files and building the preview..."
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,14"/>

            <TextBlock x:Name="StatusTextBlock"
                       Text="Starting..."
                       Foreground="#9ecbff"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <ProgressBar x:Name="LoadingProgressBar"
                         Height="22"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         IsIndeterminate="True"/>

            <TextBlock x:Name="ProgressTextBlock"
                       Text=""
                       HorizontalAlignment="Right"
                       Foreground="#cfcfcf"
                       Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</Window>

