<Window x:Class="SPTServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sptServerManager="clr-namespace:SPTServerManager"
        Title="SPT Server Manager" Height="700" Width="1000"
        ResizeMode="NoResize"
        Background="#1e1e1e" Foreground="White"
        WindowStyle="None">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <sptServerManager:WindowHeader Grid.Row="0" HeaderText="SPT Server Manager" />

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Server status texts -->
            <StackPanel Orientation="Horizontal" Grid.Row="0">
                <!-- Launcher Server Status -->
                <Label Content="Launcher Server:" FontWeight="Bold" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock x:Name="ServerStatusText" Text="Checking..." FontSize="16" Foreground="Gray" VerticalAlignment="Center"/>
                <!-- SPT Server Status -->
                <Label Content="SPT Server:" FontWeight="Bold" FontSize="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock x:Name="SptServerStatusText" Text="Checking..." FontSize="16" Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <!-- SPT Headless Manager Status -->
                <Label Content="Headless Manager:" FontWeight="Bold" FontSize="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock x:Name="SptHeadlessManagerStatusText" Text="Checking..." FontSize="16" Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <!-- SPT Headless Status -->
                <Label Content="SPT Headless:" FontWeight="Bold" FontSize="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock x:Name="SptHeadlessStatusText" Text="Checking..." FontSize="16" Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </StackPanel>

            <!-- TabControl in central area -->
            <TabControl Grid.Row="1" Background="#2d2d30" Foreground="White">

                <TabItem Header="Mods">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListView x:Name="ModListView" Grid.Row="0" Background="#1e1e1e" Foreground="White"
                                  BorderBrush="#3c3c3c" Margin="0,0,0,8">
                            <ListView.Resources>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Background" Value="#232323"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#3c3c3c"/>
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" Width="160">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOptional}" Value="True">
                                                                    <Setter Property="Foreground" Value="#ffcc99"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Version" Width="90" DisplayMemberBinding="{Binding Version}" />

                                    <GridViewColumn Header="Folder Mod" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="False"/>
                                                            <Setter Property="Foreground" Value="Tomato"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFolderMod}" Value="True">
                                                                    <Setter Property="Text" Value="True"/>
                                                                    <Setter Property="Foreground" Value="LimeGreen"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Forced" Width="65">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="False"/>
                                                            <Setter Property="Foreground" Value="Tomato"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsForced}" Value="True">
                                                                    <Setter Property="Text" Value="True"/>
                                                                    <Setter Property="Foreground" Value="LimeGreen"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Headless" Width="75">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="False"/>
                                                            <Setter Property="Foreground" Value="Tomato"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AllowOnHeadless}" Value="True">
                                                                    <Setter Property="Text" Value="True"/>
                                                                    <Setter Property="Foreground" Value="LimeGreen"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Optional" Width="75">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="False"/>
                                                            <Setter Property="Foreground" Value="Tomato"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOptional}" Value="True">
                                                                    <Setter Property="Text" Value="True"/>
                                                                    <Setter Property="Foreground" Value="LimeGreen"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Opt. Default" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="False"/>
                                                            <Setter Property="Foreground" Value="Tomato"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding OptionalDefaultState}" Value="True">
                                                                    <Setter Property="Text" Value="True"/>
                                                                    <Setter Property="Foreground" Value="LimeGreen"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="FileName" Width="180" DisplayMemberBinding="{Binding FileName}" />
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Height="30" HorizontalAlignment="Left" Margin="0,0,0,4">
                            <Button Content="Refresh Mod List" Width="130" Click="RefreshModList_Click" Background="DodgerBlue"/>
                            <Button Content="Add Mod" Width="90" Margin="5,0,0,0" Click="AddMod_Click" Background="DodgerBlue"/>
                            <Button Content="Edit Selected" Width="110" Margin="5,0,0,0" Click="EditMod_Click" Background="DodgerBlue"/>
                            <Button Content="Remove Selected" Width="130" Margin="5,0,0,0" Click="RemoveMod_Click" Background="DarkRed"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Height="30" HorizontalAlignment="Right">
                            <Button Content="Open Zip Mod Folder" Width="180" Margin="0,0,0,0"
                                    Click="OpenZipModFolder_Click"/>
                            <Button Content="Update Mods" Width="150" Margin="5,0,0,0"
                                    Click="UpdateMods_Click" Background="DarkOliveGreen"
                                    Name="UpdateModsButton"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Configs">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListView x:Name="ConfigListView" Grid.Row="0"
                                  Background="#1e1e1e" Foreground="White"
                                  BorderBrush="#3c3c3c" Margin="0,0,0,8">
                            <ListView.Resources>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Background" Value="#232323"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#3c3c3c"/>
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="File Name" Width="320" DisplayMemberBinding="{Binding FileName}" />
                                    <GridViewColumn Header="Last Modified (UTC)" Width="220" DisplayMemberBinding="{Binding LastModified}" />
                                    <GridViewColumn Header="Enforced" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="False"/>
                                                            <Setter Property="Foreground" Value="Tomato"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnforced}" Value="True">
                                                                    <Setter Property="Text" Value="True"/>
                                                                    <Setter Property="Foreground" Value="LimeGreen"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Height="30" HorizontalAlignment="Left" Margin="0,0,0,4">
                            <Button Content="Refresh Config List" Width="140" Click="RefreshConfigList_Click" Background="DodgerBlue"/>
                            <Button Content="Add Config" Width="100" Margin="5,0,0,0" Click="AddConfig_Click" Background="DodgerBlue"/>
                            <Button Content="Edit Selected" Width="110" Margin="5,0,0,0" Click="EditConfig_Click" Background="DodgerBlue"/>
                            <Button Content="Remove Selected" Width="130" Margin="5,0,0,0" Click="RemoveConfig_Click" Background="DarkRed"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Height="30" HorizontalAlignment="Right">
                            <Button Content="Update Configs" Width="150" Margin="0,0,0,8"
                                    Click="UpdateConfigs_Click" Background="DarkOliveGreen"
                                    Name="UpdateConfigsButton"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Installed Plugins Tab -->
                <TabItem Header="Installed Plugins">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListView x:Name="InstalledPluginsListView" Grid.Row="0"
                                  Background="#1e1e1e" Foreground="White"
                                  BorderBrush="#3c3c3c" Margin="0,0,0,8">
                            <ListView.Resources>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Background" Value="#232323"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#3c3c3c"/>
                                </Style>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Mod Name" Width="200" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="File Version" Width="90" DisplayMemberBinding="{Binding FileVersion}" />
                                    <GridViewColumn Header="DB Version" Width="90" DisplayMemberBinding="{Binding DbVersion}" />
                                    <GridViewColumn Header="Source" Width="120" DisplayMemberBinding="{Binding Source}" />
                                    <GridViewColumn Header="Status" Width="230">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}"
                                                           Foreground="{Binding StatusBrush}"
                                                           FontWeight="{Binding StatusFontWeight}"
                                                           VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Height="30">
                            <Button Content="Refresh" Width="90"
                                    Click="RefreshInstalledPlugins_Click" Background="DodgerBlue"/>
                            <Button Content="Allow Selected" Width="120" Margin="5,0,0,0"
                                    Click="AllowSelectedPlugin_Click" Background="DarkOliveGreen"
                                    Name="AllowSelectedPluginButton"/>
                            <Button Content="Update Selected" Width="130" Margin="5,0,0,0"
                                    IsEnabled="False" Background="#555" Foreground="#999"
                                    Name="UpdateSelectedPluginButton"/>
                            <Button Content="Update All" Width="100" Margin="5,0,0,0"
                                    IsEnabled="False" Background="#555" Foreground="#999"
                                    Name="UpdateAllPluginsButton"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Admin Tab -->
                <TabItem Header="Admin">
                    <Grid Margin="5">
                        <StackPanel>
                            <ListView Name="AdminListView" Height="250" Background="#1e1e1e" Foreground="White" BorderBrush="#3c3c3c" Margin="0,0,0,8">
                                <ListView.Resources>
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="Background" Value="#232323"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#3c3c3c"/>
                                    </Style>
                                </ListView.Resources>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Note" Width="300" DisplayMemberBinding="{Binding Note}" />
                                        <GridViewColumn Header="Is Enabled" Width="100" DisplayMemberBinding="{Binding IsEnabled}" />
                                        <GridViewColumn Header="Allow Headless Close" Width="150" DisplayMemberBinding="{Binding AllowHeadlessClose}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="Refresh Admin List" Width="150" Margin="0,0,0,8"
                                        Click="RefreshAdminList_Click" Background="DarkOliveGreen"/>
                                <Button Content="Add Admin" Width="100" Margin="0,0,0,8"
                                        Click="AddAdmin_Click" Background="DodgerBlue"/>
                                <Button Content="Edit Selected Admin" Width="140" Margin="0,0,0,8"
                                        Click="EditAdmin_Click" Background="DodgerBlue"/>
                                <Button Content="Remove Selected Admin" Width="160" Margin="0,0,0,8"
                                        Click="RemoveAdmin_Click" Background="DarkRed"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </TabItem>

            </TabControl>

            <!-- Control buttons -->
            <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Start All Servers" Name="StartAllServersButton" Width="150" Margin="5" Click="StartAllServers_Click" Height="27" Background="Green"/>
                <Button Content="Stop All Servers" Name="StopAllServersButton" Width="150" Margin="5" Click="StopAllServers_Click" Height="27" Background="DarkRed"/>
                <Button Content="Settings" Width="100" Margin="5" Click="OpenSettings_Click" Background="DodgerBlue"/>
            </StackPanel>

            <!-- Control buttons -->
            <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Start Launcher Server" Name="StartLauncherServerButton" Width="150" Margin="5" Click="StartServer_Click" Height="27" Background="Green"/>
                <Button Content="Start SPT Server" Name="StartSptServerButton" Width="150" Margin="5" Click="StartSptServer_Click" Height="27" Background="Green"/>
                <Button Content="Start SPT Headless Manager" Name="StartSptHeadlessManagerButton" Width="180" Margin="5" Click="StartSptHeadlessManager_Click" Height="27" Background="DarkGreen"/>
                <Button Content="Close Headless" Name="CloseSptHeadlessButton" Width="150" Margin="5" Click="CloseSptHeadless_Click" Height="27" Background="DarkRed"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
