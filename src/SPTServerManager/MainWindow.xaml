<Window x:Class="SPTServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sptServerManager="clr-namespace:SPTServerManager"
        Title="SPT Server Manager" Height="700" Width="1000"
        ResizeMode="NoResize"
        Background="#1e1e1e" Foreground="White"
        WindowStyle="None">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <sptServerManager:WindowHeader Grid.Row="0" HeaderText="SPT Server Manager" />

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Server status texts -->
            <StackPanel Orientation="Horizontal" Grid.Row="0">
                <!-- Launcher Server Status -->
                <Label Content="Launcher Server:" FontWeight="Bold" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock x:Name="ServerStatusText" Text="Checking..." FontSize="16" Foreground="Gray" VerticalAlignment="Center"/>
                <!-- SPT Server Status -->
                <Label Content="SPT Server:" FontWeight="Bold" FontSize="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock x:Name="SptServerStatusText" Text="Checking..." FontSize="16" Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <!-- SPT Headless Manager Status -->
                <Label Content="Headless Manager:" FontWeight="Bold" FontSize="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock x:Name="SptHeadlessManagerStatusText" Text="Checking..." FontSize="16" Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <!-- SPT Headless Status -->
                <Label Content="SPT Headless:" FontWeight="Bold" FontSize="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBlock x:Name="SptHeadlessStatusText" Text="Checking..." FontSize="16" Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </StackPanel>

            <!-- TabControl in central area -->
            <TabControl Grid.Row="1" Background="#2d2d30" Foreground="White">

                <TabItem Header="Mods">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListView x:Name="ModListView" Grid.Row="0" Background="#1e1e1e" Foreground="White"
                                  SelectionMode="Extended"
                                  BorderBrush="#3c3c3c" Margin="0,0,0,8">
                            <ListView.Resources>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Background" Value="#232323"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#3c3c3c"/>
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" Width="160">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOptional}" Value="True">
                                                                    <Setter Property="Foreground" Value="#ffcc99"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Version" Width="90" DisplayMemberBinding="{Binding Version}" />

                                    <GridViewColumn Header="Folder Mod" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="False"/>
                                                            <Setter Property="Foreground" Value="Tomato"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFolderMod}" Value="True">
                                                                    <Setter Property="Text" Value="True"/>
                                                                    <Setter Property="Foreground" Value="LimeGreen"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>


                                    <GridViewColumn Header="Headless" Width="75">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="False"/>
                                                            <Setter Property="Foreground" Value="Tomato"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AllowOnHeadless}" Value="True">
                                                                    <Setter Property="Text" Value="True"/>
                                                                    <Setter Property="Foreground" Value="LimeGreen"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Optional" Width="75">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="False"/>
                                                            <Setter Property="Foreground" Value="Tomato"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOptional}" Value="True">
                                                                    <Setter Property="Text" Value="True"/>
                                                                    <Setter Property="Foreground" Value="LimeGreen"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Opt. Default" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="False"/>
                                                            <Setter Property="Foreground" Value="Tomato"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding OptionalDefaultState}" Value="True">
                                                                    <Setter Property="Text" Value="True"/>
                                                                    <Setter Property="Foreground" Value="LimeGreen"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="FileName" Width="180" DisplayMemberBinding="{Binding FileName}" />

                                    <GridViewColumn Header="State" Width="180">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value=""/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PendingChangeState}" Value="add">
                                                                    <Setter Property="Text" Value="Waiting for addition"/>
                                                                    <Setter Property="Foreground" Value="LimeGreen"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PendingChangeState}" Value="delete">
                                                                    <Setter Property="Text" Value="Waiting for deletion"/>
                                                                    <Setter Property="Foreground" Value="Tomato"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PendingChangeState}" Value="update">
                                                                    <Setter Property="Text" Value="Waiting for update"/>
                                                                    <Setter Property="Foreground" Value="DeepSkyBlue"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Height="30" HorizontalAlignment="Left" Margin="0,0,0,4">
                            <Button Content="Refresh Mod List" Width="130" Click="RefreshModList_Click" Background="DodgerBlue"/>
                            <Button Content="Add Mod" Width="90" Margin="5,0,0,0" Click="AddMod_Click" Background="DodgerBlue"/>
                            <Button Content="Edit Selected" Width="110" Margin="5,0,0,0" Click="EditMod_Click" Background="DodgerBlue"/>
                            <Button Content="Update Selected" Width="120" Margin="5,0,0,0" Click="UpdateSelectedMod_Click" Background="DarkGreen"/>
                            <Button Content="Remove Selected" Width="130" Margin="5,0,0,0" Click="RemoveMod_Click" Background="DarkRed"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Height="30" HorizontalAlignment="Right">
                            <Button Content="Open Zip Mod Folder" Width="180" Margin="0,0,0,0"
                                    Click="OpenZipModFolder_Click"/>
                            <Button Content="Update Mods" Width="150" Margin="5,0,0,0"
                                    Click="UpdateMods_Click" Background="DarkOliveGreen"
                                    Name="UpdateModsButton"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Configs">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListView x:Name="ConfigListView" Grid.Row="0"
                                  SelectionMode="Extended"
                                  Background="#1e1e1e" Foreground="White"
                                  BorderBrush="#3c3c3c" Margin="0,0,0,8">
                            <ListView.Resources>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Background" Value="#232323"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#3c3c3c"/>
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="File Name" Width="320" DisplayMemberBinding="{Binding FileName}" />
                                    <GridViewColumn Header="Last Modified (UTC)" Width="220" DisplayMemberBinding="{Binding LastModified}" />
                                    <GridViewColumn Header="Enforced" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="False"/>
                                                            <Setter Property="Foreground" Value="Tomato"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnforced}" Value="True">
                                                                    <Setter Property="Text" Value="True"/>
                                                                    <Setter Property="Foreground" Value="LimeGreen"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Height="30" HorizontalAlignment="Left" Margin="0,0,0,4">
                            <Button Content="Refresh Config List" Width="140" Click="RefreshConfigList_Click" Background="DodgerBlue"/>
                            <Button Content="Add Config" Width="100" Margin="5,0,0,0" Click="AddConfig_Click" Background="DodgerBlue"/>
                            <Button Content="Edit Selected" Width="110" Margin="5,0,0,0" Click="EditConfig_Click" Background="DodgerBlue"/>
                            <Button Content="Remove Selected" Width="130" Margin="5,0,0,0" Click="RemoveConfig_Click" Background="DarkRed"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Height="30" HorizontalAlignment="Right">
                            <Button Content="Update Configs" Width="150" Margin="0,0,0,8"
                                    Click="UpdateConfigs_Click" Background="DarkOliveGreen"
                                    Name="UpdateConfigsButton"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Installed Plugins Tab -->
                <TabItem Header="Installed Plugins">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListView x:Name="InstalledPluginsListView" Grid.Row="0"
                                  SelectionMode="Extended"
                                  Background="#1e1e1e" Foreground="White"
                                  BorderBrush="#3c3c3c" Margin="0,0,0,8">
                            <ListView.Resources>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Background" Value="#232323"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#3c3c3c"/>
                                </Style>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Mod Name" Width="200" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="File Version" Width="90" DisplayMemberBinding="{Binding FileVersion}" />
                                    <GridViewColumn Header="DB Version" Width="90" DisplayMemberBinding="{Binding DbVersion}" />
                                    <GridViewColumn Header="Source" Width="120" DisplayMemberBinding="{Binding Source}" />
                                    <GridViewColumn Header="Status" Width="230">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}"
                                                           Foreground="{Binding StatusBrush}"
                                                           FontWeight="{Binding StatusFontWeight}"
                                                           VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Height="30">
                            <Button Content="Refresh" Width="90"
                                    Click="RefreshInstalledPlugins_Click" Background="DodgerBlue"/>
                            <Button Content="Allow Selected" Width="120" Margin="5,0,0,0"
                                    Click="AllowSelectedPlugin_Click" Background="DarkOliveGreen"
                                    Name="AllowSelectedPluginButton"/>
                            <Button Content="Update Selected" Width="130" Margin="5,0,0,0"
                                    Click="UpdateSelectedPlugin_Click" Background="DarkGreen"
                                    Name="UpdateSelectedPluginButton"/>
                            <Button Content="Update All" Width="100" Margin="5,0,0,0"
                                    Click="UpdateAllPlugins_Click" Background="DarkGreen"
                                    Name="UpdateAllPluginsButton"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Server Mods Tab -->
                <TabItem Header="Server Mods">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListView x:Name="ServerModsListView" Grid.Row="0"
                                  SelectionMode="Extended"
                                  Background="#1e1e1e" Foreground="White"
                                  BorderBrush="#3c3c3c" Margin="0,0,0,8">
                            <ListView.Resources>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Background" Value="#232323"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#3c3c3c"/>
                                </Style>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Mod Name" Width="200" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="DB Version" Width="90" DisplayMemberBinding="{Binding DbVersion}" />
                                    <GridViewColumn Header="Local Version" Width="100" DisplayMemberBinding="{Binding LocalVersion}" />
                                    <GridViewColumn Header="File Name" Width="180" DisplayMemberBinding="{Binding FileName}" />
                                    <GridViewColumn Header="Status" Width="170">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}"
                                                           Foreground="{Binding StatusBrush}"
                                                           FontWeight="{Binding StatusFontWeight}"
                                                           VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="State" Width="170">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding PendingStateLabel}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PendingStateKind}" Value="add">
                                                                    <Setter Property="Foreground" Value="LimeGreen"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PendingStateKind}" Value="delete">
                                                                    <Setter Property="Foreground" Value="Tomato"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PendingStateKind}" Value="update">
                                                                    <Setter Property="Foreground" Value="DeepSkyBlue"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel Grid.Row="1" Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="Refresh" Width="90"
                                        Click="RefreshServerMods_Click" Background="DodgerBlue"/>
                                <Button Content="Add Mod" Width="100" Margin="5,0,0,0"
                                        Click="AddServerMod_Click" Background="DarkGreen"/>
                                <Button Content="Update Selected" Width="120" Margin="5,0,0,0"
                                        Click="UpdateServerMod_Click" Background="DarkGreen"/>
                                <Button Content="Remove Mod" Width="110" Margin="5,0,0,0"
                                        Click="RemoveServerMod_Click" Background="DarkRed"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="Add to Database" Width="130"
                                        Click="AddServerModToDb_Click" Background="DodgerBlue"/>
                                <Button Content="Update to DB" Width="120" Margin="5,0,0,0"
                                        Click="UpdateServerModToDb_Click" Background="DodgerBlue"/>
                                <Button Content="Remove DB" Width="110" Margin="5,0,0,0"
                                        Click="RemoveServerModFromDb_Click" Background="DarkRed"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Add to Local" Width="110"
                                        Click="AddServerModToLocal_Click" Background="DodgerBlue"/>
                                <Button Content="Update Local" Width="110" Margin="5,0,0,0"
                                        Click="UpdateServerModLocal_Click" Background="DodgerBlue"/>
                                <Button Content="Remove Local" Width="110" Margin="5,0,0,0"
                                        Click="RemoveServerModLocal_Click" Background="DarkRed"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Admin Tab -->
                <TabItem Header="Admin">
                    <Grid Margin="5">
                        <StackPanel>
                            <ListView Name="AdminListView" Height="250" SelectionMode="Extended" Background="#1e1e1e" Foreground="White" BorderBrush="#3c3c3c" Margin="0,0,0,8">
                                <ListView.Resources>
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="Background" Value="#232323"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#3c3c3c"/>
                                    </Style>
                                </ListView.Resources>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Note" Width="300" DisplayMemberBinding="{Binding Note}" />
                                        <GridViewColumn Header="Is Enabled" Width="100" DisplayMemberBinding="{Binding IsEnabled}" />
                                        <GridViewColumn Header="Allow Headless Close" Width="150" DisplayMemberBinding="{Binding AllowHeadlessClose}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="Refresh Admin List" Width="150" Margin="0,0,0,8"
                                        Click="RefreshAdminList_Click" Background="DarkOliveGreen"/>
                                <Button Content="Add Admin" Width="100" Margin="0,0,0,8"
                                        Click="AddAdmin_Click" Background="DodgerBlue"/>
                                <Button Content="Edit Selected Admin" Width="140" Margin="0,0,0,8"
                                        Click="EditAdmin_Click" Background="DodgerBlue"/>
                                <Button Content="Remove Selected Admin" Width="160" Margin="0,0,0,8"
                                        Click="RemoveAdmin_Click" Background="DarkRed"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Pending Changes Tab -->
                <TabItem Header="Pending Changes">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListView x:Name="PendingChangesListView" Grid.Row="0"
                                  SelectionMode="Extended"
                                  Background="#1e1e1e" Foreground="White"
                                  BorderBrush="#3c3c3c" Margin="0,0,0,8">
                            <ListView.Resources>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Background" Value="#232323"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#3c3c3c"/>
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Mod Name" Width="180" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="Type" Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ModType}" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ModType}" Value="Server">
                                                                    <Setter Property="Foreground" Value="Gold"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Curr. Version" Width="90" DisplayMemberBinding="{Binding Version}" />
                                    <GridViewColumn Header="Change Type" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding PendingStateLabel}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PendingStateKind}" Value="add">
                                                                    <Setter Property="Foreground" Value="LimeGreen"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PendingStateKind}" Value="delete">
                                                                    <Setter Property="Foreground" Value="Tomato"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding PendingStateKind}" Value="update">
                                                                    <Setter Property="Foreground" Value="DeepSkyBlue"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="New Version" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding NewVersion}" VerticalAlignment="Center" Foreground="Yellow"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Height="30" Margin="0,0,0,8">
                            <CheckBox x:Name="RestartServersCheckBox"
                                      Content="Restart servers if update started servers online"
                                      Checked="RestartServersCheckBox_Changed"
                                      Unchecked="RestartServersCheckBox_Changed"
                                      VerticalAlignment="Center"
                                      Foreground="White"
                                      Background="Transparent"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Height="30" HorizontalAlignment="Left">
                            <Button Content="Refresh" Width="90"
                                    Click="RefreshPendingChanges_Click" Background="DodgerBlue"/>
                            <Button Content="Temp Diagnostics" Width="130" Margin="5,0,0,0"
                                    Click="ShowPendingTempDiagnostics_Click" Background="#555" Foreground="White"/>
                            <Button Content="Revert Selected" Width="130" Margin="5,0,0,0"
                                    Click="RevertSelectedPendingChange_Click" Background="DarkRed"/>
                            <Button x:Name="UpdateChangesButton" Content="Update Changes" Width="300" Margin="5,0,0,0"
                                    Click="UpdatePendingChanges_Click" Background="Green"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Players">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="190"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Active players:" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PlayerPresenceCountText" Text="0" Margin="5,0,15,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Updated:" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PlayerPresenceLastUpdatedText" Text="—" Margin="5,0,15,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Raid:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="RaidStatusText" Text="No Raid" Margin="0,0,15,0" VerticalAlignment="Center" Foreground="Gray"/>
                            <TextBlock Text="Log:" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PlayerPresenceLogFileText" Text="—" Margin="5,0,0,0" Width="340" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <ListView x:Name="PlayerPresenceListView"
                                      Background="#1e1e1e" Foreground="White"
                                      BorderBrush="#3c3c3c" Margin="0,0,0,8">
                                <ListView.Resources>
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="Background" Value="#232323"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#3c3c3c"/>
                                    </Style>
                                </ListView.Resources>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Name" Width="220" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="Account Id" Width="300" DisplayMemberBinding="{Binding AccountId}" />
                                        <GridViewColumn Header="State" Width="170">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding State}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="Gray"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding State}" Value="Connected">
                                                                        <Setter Property="Foreground" Value="LimeGreen"/>
                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="Disconnected or Joining">
                                                                        <Setter Property="Foreground" Value="Gold"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="In Solo Raid">
                                                                        <Setter Property="Foreground" Value="DeepSkyBlue"/>
                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="Disconnected after Local Raid">
                                                                        <Setter Property="Foreground" Value="SkyBlue"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="Starting Raid">
                                                                        <Setter Property="Foreground" Value="Orange"/>
                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="Hosting Raid">
                                                                        <Setter Property="Foreground" Value="MediumPurple"/>
                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="In Headless Raid">
                                                                        <Setter Property="Foreground" Value="DodgerBlue"/>
                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="Disconnected after Headless Raid">
                                                                        <Setter Property="Foreground" Value="MediumPurple"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="Disconnected">
                                                                        <Setter Property="Foreground" Value="Tomato"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Last Seen Stamp" Width="180" DisplayMemberBinding="{Binding LastSeenStamp}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ListView x:Name="PlayerPresenceEventsListView" Grid.Column="0"
                                      Background="#1e1e1e" Foreground="White"
                                      BorderBrush="#3c3c3c" Margin="0,0,4,0">
                                <ListView.Resources>
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="Background" Value="#232323"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#3c3c3c"/>
                                    </Style>
                                </ListView.Resources>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Stamp" Width="180" DisplayMemberBinding="{Binding Stamp}" />
                                        <GridViewColumn Header="Name" Width="160" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="Account Id" Width="220" DisplayMemberBinding="{Binding AccountId}" />
                                        <GridViewColumn Header="Event" Width="90">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock HorizontalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Disconnected"/>
                                                                <Setter Property="Foreground" Value="Tomato"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                        <Setter Property="Text" Value="Connected"/>
                                                                        <Setter Property="Foreground" Value="LimeGreen"/>
                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <Grid Grid.Column="1" Margin="4,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Headless Status:" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HeadlessStatusText" Text="Disconnected" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
                                    <TextBlock Text="Location:" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    <TextBlock x:Name="HeadlessLocationText" Text="Unknown" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="White"/>
                                </StackPanel>

                                <ListView x:Name="HeadlessRaidPlayersListView" Grid.Row="1"
                                          Background="#1e1e1e" Foreground="White"
                                          BorderBrush="#3c3c3c">
                                    <ListView.Resources>
                                        <Style TargetType="GridViewColumnHeader">
                                            <Setter Property="Background" Value="#232323"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#3c3c3c"/>
                                        </Style>
                                    </ListView.Resources>
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Headless Raid Players" Width="300" DisplayMemberBinding="{Binding}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Grid>

                        <StackPanel Grid.Row="3" Orientation="Horizontal">
                            <Button Content="Refresh Players" Width="130" Click="RefreshPlayerPresence_Click" Background="DodgerBlue"/>
                            <TextBlock x:Name="PlayerPresenceStatusText" Text="Not loaded" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Settings">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0" Content="Launcher Port:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="SettingsLauncherPortTextBox"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0" Content="SPT Server Folder:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="SettingsServerFolderTextBox" Margin="0,0,5,0"/>
                            <Button Grid.Column="2" Content="Browse" Width="65" Margin="0,0,5,0" Click="BrowseSettingsServerFolder_Click" Background="DodgerBlue"/>
                            <Button Grid.Column="3" Content="Open" Width="55" Click="OpenSettingsServerFolder_Click" Background="DodgerBlue"/>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0" Content="Additional Mods Folder:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="SettingsAdditionalModsTextBox" Margin="0,0,5,0"/>
                            <Button Grid.Column="2" Content="Browse" Width="65" Margin="0,0,5,0" Click="BrowseSettingsAdditionalModsFolder_Click" Background="DodgerBlue"/>
                            <Button Grid.Column="3" Content="Open" Width="55" Click="OpenSettingsAdditionalModsFolder_Click" Background="DodgerBlue"/>
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0" Content="Headless Client Folder:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="SettingsHeadlessFolderTextBox" Margin="0,0,5,0"/>
                            <Button Grid.Column="2" Content="Browse" Width="65" Margin="0,0,5,0" Click="BrowseSettingsHeadlessFolder_Click" Background="DodgerBlue"/>
                            <Button Grid.Column="3" Content="Open" Width="55" Click="OpenSettingsHeadlessFolder_Click" Background="DodgerBlue"/>
                        </Grid>

                        <Grid Grid.Row="4" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0" Content="Local Headless Player Id:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="SettingsLocalHeadlessPlayerIdTextBox"/>
                        </Grid>

                        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="Save Settings" Width="140" Click="SaveSettingsTab_Click" Background="ForestGreen"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

            </TabControl>

            <!-- Control buttons -->
            <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Start All Servers" Name="StartAllServersButton" Width="150" Margin="5" Click="StartAllServers_Click" Height="27" Background="Green"/>
                <Button Content="Stop All Servers" Name="StopAllServersButton" Width="150" Margin="5" Click="StopAllServers_Click" Height="27" Background="DarkRed"/>
            </StackPanel>

            <!-- Control buttons -->
            <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Start Launcher Server" Name="StartLauncherServerButton" Width="150" Margin="5" Click="StartServer_Click" Height="27" Background="Green"/>
                <Button Content="Start SPT Server" Name="StartSptServerButton" Width="150" Margin="5" Click="StartSptServer_Click" Height="27" Background="Green"/>
                <Button Content="Start SPT Headless Manager" Name="StartSptHeadlessManagerButton" Width="180" Margin="5" Click="StartSptHeadlessManager_Click" Height="27" Background="DarkGreen"/>
                <Button Content="Close Headless" Name="CloseSptHeadlessButton" Width="150" Margin="5" Click="CloseSptHeadless_Click" Height="27" Background="DarkRed"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
