<Window x:Class="SPTServerManager.FileChangePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sptServerManager="clr-namespace:SPTServerManager"
        Title="Incoming File Changes" Height="700" Width="1200"
        ResizeMode="NoResize"
        Background="#1e1e1e" Foreground="White"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ShowInTaskbar="False">
    <Window.Resources>
        <SolidColorBrush x:Key="ComboBoxNormalBrush" Color="#2d2d30"/>
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#555555"/>
        <SolidColorBrush x:Key="ComboBoxForeground" Color="White"/>
        <SolidColorBrush x:Key="ComboBoxDisabledForeground" Color="#888888"/>
        <SolidColorBrush x:Key="ComboBoxMouseOverBrush" Color="#3d3d40"/>
        <SolidColorBrush x:Key="ComboBoxSelectedBrush" Color="#007acc"/>

        <ControlTemplate x:Key="ComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton
                            Background="{StaticResource ComboBoxNormalBrush}"
                            Foreground="{StaticResource ComboBoxForeground}"
                            BorderBrush="{StaticResource ComboBoxBorderBrush}"
                            BorderThickness="1"
                            Padding="3"
                            IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            ClickMode="Press">
                    ▼
                </ToggleButton>
                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                Margin="3"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"/>
                <Popup Name="Popup"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Slide">
                    <Grid Name="DropDown"
                          SnapsToDevicePixels="True"
                          MinWidth="{TemplateBinding ActualWidth}"
                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <Border x:Name="DropDownBorder"
                               Background="{StaticResource ComboBoxNormalBrush}"
                               BorderThickness="1"
                               BorderBrush="{StaticResource ComboBoxBorderBrush}"/>
                        <ScrollViewer SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True"
                                      KeyboardNavigation.DirectionalNavigation="Contained"/>
                        </ScrollViewer>
                    </Grid>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource ComboBoxNormalBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ComboBoxForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ComboBoxBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Template" Value="{StaticResource ComboBoxTemplate}"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource ComboBoxNormalBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ComboBoxForeground}"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0"/>
            <EventSetter Event="MouseEnter" Handler="ComboBoxItem_MouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="ComboBoxItem_MouseLeave"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header using WindowHeader component -->
        <sptServerManager:WindowHeader Grid.Row="0" HeaderText="Incoming File Changes" />

        <Grid Grid.Row="1" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="ActionSummaryTextBlock"
                   Text="Pending file changes"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,8"/>

         <StackPanel Grid.Row="1" Margin="0,0,0,8">
             <TextBlock x:Name="DetectedSummaryTextBlock"
                        Foreground="#9ecbff"
                        TextWrapping="Wrap"
                        Text="Detected: Unknown"/>
             <TextBlock x:Name="PluginSummaryTextBlock"
                        Foreground="#b7f0c1"
                        Margin="0,3,0,0"
                        TextWrapping="Wrap"
                        Text="Plugin: -"/>
             <TextBlock x:Name="PluginRevisionSummaryTextBlock"
                        Foreground="#b7f0c1"
                        Margin="0,3,0,0"
                        TextWrapping="Wrap"
                        Text="Plugin Old Revision: -"/>
             <TextBlock x:Name="ServerSummaryTextBlock"
                        Foreground="#f7d794"
                        Margin="0,3,0,0"
                        TextWrapping="Wrap"
                        Text="Server Mod: -"/>
             <TextBlock x:Name="ServerRevisionSummaryTextBlock"
                        Foreground="#f7d794"
                        Margin="0,3,0,0"
                        TextWrapping="Wrap"
                        Text="Server Mod Old Revision: -"/>
         </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="PluginVersionPanel" Grid.Column="0" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <CheckBox x:Name="PluginIncludeCheckBox"
                              Content="Include"
                              Foreground="White"
                              IsChecked="True"
                              VerticalAlignment="Center"/>
                    <TextBlock Text="Plugin New Version" Foreground="#b7f0c1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBox x:Name="PluginVersionBox" Background="#2d2d30" Foreground="White" BorderBrush="#555" Padding="4"/>
                <TextBlock Text="Plugin Revision" Foreground="#b7f0c1" Margin="0,6,0,4"/>
                <TextBox x:Name="PluginRevisionBox" Background="#2d2d30" Foreground="White" BorderBrush="#555" Padding="4"/>
            </StackPanel>

            <StackPanel x:Name="ServerVersionPanel" Grid.Column="1" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <CheckBox x:Name="ServerIncludeCheckBox"
                              Content="Include"
                              Foreground="White"
                              IsChecked="True"
                              VerticalAlignment="Center"/>
                    <TextBlock Text="Server Mod New Version" Foreground="#f7d794" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBox x:Name="ServerVersionBox" Background="#2d2d30" Foreground="White" BorderBrush="#555" Padding="4"/>
                <TextBlock Text="Server Mod Revision" Foreground="#f7d794" Margin="0,6,0,4"/>
                <TextBox x:Name="ServerRevisionBox" Background="#2d2d30" Foreground="White" BorderBrush="#555" Padding="4"/>
            </StackPanel>

            <StackPanel x:Name="PluginFlagsPanel" Grid.Column="2" Margin="8,0,0,0">
                <TextBlock Text="Plugin Options" Foreground="#9ecbff" Margin="0,0,0,4"/>
                <CheckBox x:Name="PluginIsFolderModCheckBox" Content="Is Folder Mod (from structure)" Foreground="White" IsEnabled="False"/>
                <CheckBox x:Name="PluginAllowOnHeadlessCheckBox" Content="Allow On Headless" Foreground="White"/>
                <CheckBox x:Name="PluginIsOptionalCheckBox" Content="Is Optional" Foreground="White"/>
                <CheckBox x:Name="PluginOptionalDefaultStateCheckBox" Content="Optional Default State" Foreground="White"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3"
                x:Name="ConfigWarningBorder"
                Background="#553300"
                BorderBrush="#aa8800"
                BorderThickness="1"
                Padding="8"
                Margin="0,0,0,8"
                Visibility="Collapsed">
            <TextBlock x:Name="ConfigWarningTextBlock"
                       Foreground="#ffd27f"
                       TextWrapping="Wrap"
                       Text="Config-like files already exist in the old mod. Choose whether to keep old config files or override them with new ones."/>
        </Border>


        <ListView Grid.Row="4"
                  x:Name="FilesListView"
                  Background="#1e1e1e"
                  Foreground="White"
                  BorderBrush="#3c3c3c">
            <ListView.Resources>
                <Style TargetType="GridViewColumnHeader">
                    <Setter Property="Background" Value="#232323"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#3c3c3c"/>
                </Style>
            </ListView.Resources>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Action" Width="130">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding SelectionOptions}"
                                          SelectedItem="{Binding SelectionChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Width="120"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Type" Width="90" DisplayMemberBinding="{Binding FileType}" />
                    <GridViewColumn Header="File Name" Width="260" DisplayMemberBinding="{Binding FileName}" />
                    <GridViewColumn Header="Location" Width="320" DisplayMemberBinding="{Binding Location}" />
                    <GridViewColumn Header="Source" Width="100" DisplayMemberBinding="{Binding SourceKind}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Keep All" Width="95" Margin="0,0,8,0" Click="SelectAll_Click" Background="#3b82f6"/>
            <Button Content="Skip All" Width="95" Margin="0,0,8,0" Click="SelectNone_Click" Background="#8b5cf6"/>
            <Button Content="Cancel" Width="95" Margin="0,0,8,0" Click="Cancel_Click" Background="#555"/>
            <Button Content="Continue" Width="160" Click="ContinueOverride_Click" Background="DarkOliveGreen"/>
        </StackPanel>
    </Grid>
    </Grid>
</Window>




