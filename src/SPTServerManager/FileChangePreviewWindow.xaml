<Window x:Class="SPTServerManager.FileChangePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Incoming File Changes" Height="560" Width="860"
        ResizeMode="NoResize"
        Background="#1e1e1e" Foreground="White"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="ActionSummaryTextBlock"
                   Text="Pending file changes"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,8"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock x:Name="DetectedSummaryTextBlock"
                       Foreground="#9ecbff"
                       TextWrapping="Wrap"
                       Text="Detected: Unknown"/>
            <TextBlock x:Name="PluginSummaryTextBlock"
                       Foreground="#b7f0c1"
                       Margin="0,3,0,0"
                       TextWrapping="Wrap"
                       Text="Plugin: -"/>
            <TextBlock x:Name="ServerSummaryTextBlock"
                       Foreground="#f7d794"
                       Margin="0,3,0,0"
                       TextWrapping="Wrap"
                       Text="Server Mod: -"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="PluginVersionPanel" Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Plugin New Version" Foreground="#b7f0c1" Margin="0,0,0,4"/>
                <TextBox x:Name="PluginVersionBox" Background="#2d2d30" Foreground="White" BorderBrush="#555" Padding="4"/>
            </StackPanel>

            <StackPanel x:Name="ServerVersionPanel" Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Server Mod New Version" Foreground="#f7d794" Margin="0,0,0,4"/>
                <TextBox x:Name="ServerVersionBox" Background="#2d2d30" Foreground="White" BorderBrush="#555" Padding="4"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3"
                x:Name="ConfigWarningBorder"
                Background="#553300"
                BorderBrush="#aa8800"
                BorderThickness="1"
                Padding="8"
                Margin="0,0,0,8"
                Visibility="Collapsed">
            <TextBlock x:Name="ConfigWarningTextBlock"
                       Foreground="#ffd27f"
                       TextWrapping="Wrap"
                       Text="Config-like files already exist in the old mod. Choose whether to keep old config files or override them with new ones."/>
        </Border>

        <ListView Grid.Row="4"
                  x:Name="FilesListView"
                  Background="#1e1e1e"
                  Foreground="White"
                  BorderBrush="#3c3c3c">
            <ListView.Resources>
                <Style TargetType="GridViewColumnHeader">
                    <Setter Property="Background" Value="#232323"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#3c3c3c"/>
                </Style>
            </ListView.Resources>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Include" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Type" Width="90" DisplayMemberBinding="{Binding FileType}" />
                    <GridViewColumn Header="File Name" Width="260" DisplayMemberBinding="{Binding FileName}" />
                    <GridViewColumn Header="Location" Width="320" DisplayMemberBinding="{Binding Location}" />
                    <GridViewColumn Header="Exist In Old" Width="100" DisplayMemberBinding="{Binding ExistsInOldText}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Select All" Width="95" Margin="0,0,8,0" Click="SelectAll_Click" Background="#3b82f6"/>
            <Button Content="Select None" Width="95" Margin="0,0,8,0" Click="SelectNone_Click" Background="#8b5cf6"/>
            <Button Content="Cancel" Width="95" Margin="0,0,8,0" Click="Cancel_Click" Background="#555"/>
            <Button x:Name="KeepOldConfigButton"
                    Content="Keep Old Config"
                    Width="150"
                    Margin="0,0,8,0"
                    Visibility="Collapsed"
                    Click="KeepOldConfig_Click"
                    Background="#2d6a4f"/>
            <Button Content="Continue" Width="160" Click="ContinueOverride_Click" Background="DarkOliveGreen"/>
        </StackPanel>
    </Grid>
</Window>

