<Window x:Class="SPTServerManager.UpdateModWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Mod" Height="300" Width="500"
        ResizeMode="NoResize"
        Background="#1e1e1e" Foreground="White"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Label Grid.Row="0" Content="Update Mod" FontWeight="Bold" FontSize="16" Foreground="White" Padding="10,10,10,5"/>

        <!-- Current Version -->
        <Grid Grid.Row="1" Margin="10,5,10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Current Version:" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="CurrentVersionTextBlock" Text="-" VerticalAlignment="Center" Foreground="LimeGreen"/>
        </Grid>

        <!-- File Selection -->
        <Grid Grid.Row="2" Margin="10,5,10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Select File:" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="FileNameTextBlock" Text="No file selected" VerticalAlignment="Center" Foreground="Gray" Margin="0,0,5,0"/>
            <Button Grid.Column="2" Content="Browse..." Width="80" Click="BrowseFile_Click" Background="DodgerBlue"/>
        </Grid>

        <!-- New Version -->
        <Grid Grid.Row="3" Margin="10,5,10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="New Version:" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="NewVersionTextBlock" Text="-" VerticalAlignment="Center" Foreground="Yellow"/>
        </Grid>

        <!-- Separator -->
        <Separator Grid.Row="4" Background="#3c3c3c" Margin="10,10,10,10"/>

        <!-- File Info -->
        <Grid Grid.Row="5" Margin="10,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="File Name:" VerticalAlignment="Top"/>
            <TextBlock Grid.Column="1" x:Name="SelectedFilePathTextBlock" Text="-" VerticalAlignment="Top" Foreground="Gray" TextWrapping="Wrap"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="Cancel" Width="80" Margin="0,0,5,0" Click="Cancel_Click" Background="#555"/>
            <Button Content="Update" Width="80" Click="Update_Click" Background="Green" x:Name="UpdateButton" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>

