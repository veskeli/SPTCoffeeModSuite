<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Base colors -->
    <Color x:Key="Clr-Dark-A0">#000000</Color>
    <Color x:Key="Clr-Light-A0">#ffffff</Color>

    <!-- Theme primary colors -->
    <Color x:Key="Clr-Primary-A0">#407f32</Color>
    <Color x:Key="Clr-Primary-A10">#568d48</Color>
    <Color x:Key="Clr-Primary-A20">#6b9b5e</Color>
    <Color x:Key="Clr-Primary-A30">#80a973</Color>
    <Color x:Key="Clr-Primary-A40">#95b78a</Color>
    <Color x:Key="Clr-Primary-A50">#aac5a0</Color>

    <!-- Theme surface colors -->
    <Color x:Key="Clr-Surface-A0">#121212</Color>
    <Color x:Key="Clr-Surface-A10">#282828</Color>
    <Color x:Key="Clr-Surface-A20">#3f3f3f</Color>
    <Color x:Key="Clr-Surface-A30">#575757</Color>
    <Color x:Key="Clr-Surface-A40">#717171</Color>
    <Color x:Key="Clr-Surface-A50">#8b8b8b</Color>

    <!-- Theme tonal surface colors -->
    <Color x:Key="Clr-Surface-Tonal-A0">#181c16</Color>
    <Color x:Key="Clr-Surface-Tonal-A10">#2d312b</Color>
    <Color x:Key="Clr-Surface-Tonal-A20">#444742</Color>
    <Color x:Key="Clr-Surface-Tonal-A30">#5c5f5a</Color>
    <Color x:Key="Clr-Surface-Tonal-A40">#757773</Color>
    <Color x:Key="Clr-Surface-Tonal-A50">#8f918d</Color>

    <!-- Success colors -->
    <Color x:Key="Clr-Success-A0">#22946e</Color>
    <Color x:Key="Clr-Success-A10">#47d5a6</Color>
    <Color x:Key="Clr-Success-A20">#9ae8ce</Color>

    <!-- Warning colors -->
    <Color x:Key="Clr-Warning-A0">#a87a2a</Color>
    <Color x:Key="Clr-Warning-A10">#d7ac61</Color>
    <Color x:Key="Clr-Warning-A20">#ecd7b2</Color>

    <!-- Danger colors -->
    <Color x:Key="Clr-Danger-A0">#9c2121</Color>
    <Color x:Key="Clr-Danger-A10">#d94a4a</Color>
    <Color x:Key="Clr-Danger-A20">#eb9e9e</Color>

    <!-- Info colors -->
    <Color x:Key="Clr-Info-A0">#21498a</Color>
    <Color x:Key="Clr-Info-A10">#4077d1</Color>
    <Color x:Key="Clr-Info-A20">#92b2e5</Color>

    <!-- Brushes mapped to palette -->
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource Clr-Light-A0}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource Clr-Surface-A50}" />

    <SolidColorBrush x:Key="BrushAppBackground" Color="{StaticResource Clr-Surface-A0}" />
    <SolidColorBrush x:Key="BrushSurface1" Color="{StaticResource Clr-Surface-A10}" />
    <SolidColorBrush x:Key="BrushSurface2" Color="{StaticResource Clr-Surface-A20}" />
    <SolidColorBrush x:Key="BrushSurface3" Color="{StaticResource Clr-Surface-A30}" />
    <SolidColorBrush x:Key="BrushSurface4" Color="{StaticResource Clr-Surface-A40}" />
    <SolidColorBrush x:Key="BrushSurface5" Color="{StaticResource Clr-Surface-A50}" />

    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource Clr-Primary-A0}" />
    <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource Clr-Primary-A10}" />
    <SolidColorBrush x:Key="BrushAccentPressed" Color="{StaticResource Clr-Primary-A20}" />

    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource Clr-Surface-A20}" />

    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource Clr-Success-A0}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource Clr-Warning-A0}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource Clr-Danger-A0}" />
    <SolidColorBrush x:Key="BrushInfo" Color="{StaticResource Clr-Info-A0}" />

    <SolidColorBrush x:Key="BrushSuccessAlt" Color="{StaticResource Clr-Success-A10}" />
    <SolidColorBrush x:Key="BrushWarningAlt" Color="{StaticResource Clr-Warning-A10}" />
    <SolidColorBrush x:Key="BrushDangerAlt" Color="{StaticResource Clr-Danger-A10}" />
    <SolidColorBrush x:Key="BrushInfoAlt" Color="{StaticResource Clr-Info-A10}" />

    <SolidColorBrush x:Key="BrushAccentAlt" Color="{StaticResource Clr-Primary-A10}" />
    <SolidColorBrush x:Key="SecondaryBrushAccent" Color="{StaticResource Clr-Primary-A30}" />
    <SolidColorBrush x:Key="SecondaryBrushAccentAlt" Color="{StaticResource Clr-Primary-A40}" />

    <!-- Dynamic Brushes for icons and other elements that may need to adapt to theme changes -->
    <SolidColorBrush x:Key="BrushTabText" Color="{StaticResource Clr-Primary-A0}" />
</ResourceDictionary>

