<Window x:Class="SPTCoffeeModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sptCoffeeModManager="clr-namespace:SPTCoffeeModManager"
        xmlns:tabs="clr-namespace:SPTCoffeeModManager.Tabs"
        mc:Ignorable="d"
        Title="SPT Coffee Mod Manager" Height="550" Width="1000"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushAppBackground}" Foreground="{DynamicResource BrushTextPrimary}"
        WindowStyle="None">
    <Window.Resources>
        <Style x:Key="TabNavButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,4,10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="ActiveIndicator"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        Margin="3,6,0,6"
                                        CornerRadius="2"
                                        Background="{DynamicResource SecondaryBrushAccent}"
                                        Opacity="0" />
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="Tag" Value="{x:Null}" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource BrushSurface2}" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource BrushSurface3}" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsPressed" Value="True" />
                                    <Condition Property="Tag" Value="{x:Null}" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource BrushSurface3}" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource BrushSurface4}" />
                            </MultiTrigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource BrushSurface1}" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Active" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource BrushSurface2}" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Active" />
                                    <Condition Property="IsPressed" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource BrushSurface3}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <sptCoffeeModManager:WindowHeader Grid.Row="0" HeaderText="SPT Coffee Mod Manager" />

        <!-- Main Content with Vertical Tab Control -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Tab Buttons (Vertical) -->
            <StackPanel Grid.Column="0" Orientation="Vertical" Background="{DynamicResource BrushSurface1}" Margin="0">

                <!-- Coffee Cup Icon -->

                <Image Source="{StaticResource IconCoffeeCup}"
                       Width="40"
                       Height="40"
                       Margin="10"
                       HorizontalAlignment="Center"/>

                <Button Name="HomeTabButton"
                        Style="{StaticResource TabNavButtonStyle}"
                        Tag="Active"
                        Height="40"
                        Width="Auto"
                        Click="HomeTab_Click"
                        Margin="10,5,10,5">

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- HOME ICON -->
                        <Path Data="{StaticResource IconHome}"
                              Fill="{DynamicResource BrushTextPrimary}"
                              Stretch="Uniform"
                              Width="18"
                              Height="18"/>

                        <!-- HOME TEXT -->
                        <TextBlock Text="Home"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Foreground="{DynamicResource BrushTextPrimary}" />

                    </StackPanel>
                </Button>
                <Button Name="ModsTabButton"
                        Style="{StaticResource TabNavButtonStyle}"
                        Height="40"
                        Width="Auto"
                        Click="ModsTab_Click"
                        Margin="10,5,10,5">

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- MODS ICON -->
                        <Image Source="{StaticResource IconMods}"
                               Width="18"
                               Height="18"/>

                        <!-- MODS TEXT -->
                        <TextBlock Text="Mods"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Foreground="{DynamicResource BrushTextPrimary}" />

                    </StackPanel>
                </Button>
                <Button Name="SettingsTabButton"
                        Style="{StaticResource TabNavButtonStyle}"
                        Height="40"
                        Width="Auto"
                        Click="SettingsTab_Click"
                        Margin="10,5,10,5">

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">

                        <!-- SETTINGS ICON -->
                        <Image Source="{StaticResource IconSettings}"
                               Width="18"
                               Height="18"/>

                        <!-- SETTINGS TEXT -->
                        <TextBlock Text="Settings"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Foreground="{DynamicResource BrushTextPrimary}" />

                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Tab Content -->
            <Grid Grid.Column="1" Background="{DynamicResource BrushAppBackground}" Margin="5">
                <!-- Home Tab -->
                <tabs:HomeTab x:Name="HomeTabContent" />

                <!-- Mods Tab -->
                <tabs:ModsTab x:Name="ModsTabContent" Visibility="Collapsed" />

                <!-- Settings Tab -->
                <tabs:SettingsTab x:Name="SettingsTabContent" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Window>
