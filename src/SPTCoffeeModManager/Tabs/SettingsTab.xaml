<UserControl x:Class="SPTCoffeeModManager.Tabs.SettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="860"
             d:DesignHeight="480"
             Background="#121212">
    <StackPanel Margin="5">

        <!-- Header outside the rounded box, matching HomeTab quick status visuals -->
        <TextBlock Text="Server Configuration" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" FontSize="13" Margin="0,0,0,6" />

        <!-- Rounded container similar to HomeTab's Quick Status -->
        <Border Background="{DynamicResource BrushSurface1}" HorizontalAlignment="Left" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <StackPanel Width="420">
                <!-- Server Address -->
                <TextBlock Text="Server Address" Margin="0,4" Foreground="{DynamicResource BrushTextPrimary}" />
                <TextBox x:Name="AddressTextBox"
                         Height="30"
                         Margin="0,6,0,0"
                         Background="{DynamicResource BrushSurface2}"
                         BorderBrush="{DynamicResource BrushBorder}"
                         Foreground="{DynamicResource BrushTextPrimary}" />

                <!-- Port -->
                <TextBlock Text="Port" Margin="0,12,0,4" Foreground="{DynamicResource BrushTextPrimary}" />
                <TextBox x:Name="PortTextBox"
                         Height="30"
                         Margin="0,6,0,0"
                         Background="{DynamicResource BrushSurface2}"
                         BorderBrush="{DynamicResource BrushBorder}"
                         Foreground="{DynamicResource BrushTextPrimary}" />

                <!-- SPT Server Address -->
                <TextBlock Text="SPT Server Address" Margin="0,12,0,4" Foreground="{DynamicResource BrushTextPrimary}" />
                <TextBox x:Name="SptServerAddressTextBox"
                         Height="30"
                         Margin="0,6,0,0"
                         Background="{DynamicResource BrushSurface2}"
                         BorderBrush="{DynamicResource BrushBorder}"
                         Foreground="{DynamicResource BrushTextPrimary}" />

                <!-- Secret Key -->
                <TextBlock Text="Admin Secret Key" Margin="0,12,0,4" Foreground="{DynamicResource BrushTextPrimary}" />
                <PasswordBox x:Name="SecretKeyTextBox"
                             Height="30"
                             Margin="0,6,0,0"
                             Background="{DynamicResource BrushSurface2}"
                             BorderBrush="{DynamicResource BrushBorder}"
                             Foreground="{DynamicResource BrushTextPrimary}" />

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                    <Button x:Name="SaveButton"
                            Click="SaveButton_Click"
                            Content="Save"
                            Width="110"
                            Height="34"
                            Margin="0,0,8,0"
                            Background="{DynamicResource BrushAccent}"
                            Foreground="{DynamicResource BrushTextPrimary}"
                            BorderBrush="{DynamicResource BrushBorder}" />

                </StackPanel>

            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
