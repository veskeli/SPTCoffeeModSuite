<UserControl x:Class="SPTCoffeeModManager.Tabs.ModsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="860"
             d:DesignHeight="480"
             Background="#121212">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10" Height="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Installed Mods" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" FontSize="14" VerticalAlignment="Center" />
            <Button Grid.Column="1" Name="RefreshModsButton" Content="⟳ Refresh" Width="80" Height="25"
                    Style="{StaticResource ButtonAccentStyle}" />
        </Grid>

        <!-- Mod list moved to Home tab. Show a small placeholder and instructions here -->
        <Border Grid.Row="1" Background="{DynamicResource BrushSurface1}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,5">
            <TextBlock Text="WIP" Foreground="{DynamicResource BrushTextMuted}" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Height="40" Margin="0,10,0,0">
            <Button Name="CheckForModsButton" Content="Check for mods" Width="120"
                    Style="{StaticResource ButtonAccentStyle}" />
        </StackPanel>
    </Grid>
</UserControl>